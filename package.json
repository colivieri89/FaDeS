{
  "name": "fades",
  "productName": "FaDeS",
  "version": "1.0.0",
  "description": "FaDeS (Façade Debris Simulator): rigid-block simulation of the out-of-plane overturning of masonry façades and of the debris on the street, for any wall; it also reproduces the analyses of the paper that describes the model.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "Carlo Olivieri, Generoso Vaiano, Luigi Sibille, Giovanni Mochi, Francesco Fabbrocino",
  "homepage": "https://github.com/colivieri89/FaDeS",
  "repository": {
    "type": "git",
    "url": "https://github.com/colivieri89/FaDeS.git"
  },
  "bugs": {
    "url": "https://github.com/colivieri89/FaDeS/issues"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "cli": "node src/cli/cli.js",
    "icon": "electron scripts/make_icon.js",
    "screenshots": "electron scripts/screenshots.js docs/screenshots",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "planck": "1.5.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.colivieri89.fades",
    "productName": "FaDeS",
    "copyright": "Copyright © 2026 Carlo Olivieri, Generoso Vaiano, Luigi Sibille, Giovanni Mochi, Francesco Fabbrocino",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "LICENSE",
      "src/**/*",
      "reference/campaign_runs.json",
      "reference/breakup_p95.json",
      "reference/walls_template.csv",
      "reference/integrity_nominal.json",
      "reference/rigid_checks.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "FaDeS ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FaDeS-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science",
      "icon": "build/icon.png"
    }
  }
}
